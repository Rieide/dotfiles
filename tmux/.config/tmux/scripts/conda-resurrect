#!/usr/bin/env bash

set -u

pane_option="@resurrect-conda-environment"
record_type="conda_environment"

encode_value() {
  base64 | tr -d '\n'
}

decode_value() {
  base64 --decode 2>/dev/null
}

track_pane() {
  [[ -n "${TMUX_PANE:-}" ]] || return 0
  command -v tmux >/dev/null 2>&1 || return 0

  local state
  if [[ -n "${CONDA_DEFAULT_ENV:-}" ]]; then
    state="active:$(printf '%s' "$CONDA_DEFAULT_ENV" | encode_value)"
  else
    state="inactive"
  fi

  tmux set-option -pq -t "$TMUX_PANE" "$pane_option" "$state"
}

save_panes() {
  local state_file="${1:-}"
  [[ -n "$state_file" && -f "$state_file" ]] || return 0

  local tab=$'\t'
  local format
  format="#{session_name}${tab}#{window_index}${tab}#{pane_index}${tab}#{${pane_option}}"

  local session_name window_index pane_index state
  while IFS=$'\t' read -r session_name window_index pane_index state; do
    case "$state" in
      inactive|active:*)
        printf '%s\t%s\t%s\t%s\t%s\n' \
          "$record_type" "$session_name" "$window_index" "$pane_index" "$state" \
          >> "$state_file"
        ;;
    esac
  done < <(tmux list-panes -a -F "$format")
}

resurrect_file() {
  local resurrect_dir
  resurrect_dir="$(tmux show-option -gqv @resurrect-dir)"
  [[ -n "$resurrect_dir" ]] || resurrect_dir="${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect"
  resurrect_dir="${resurrect_dir/#\~/$HOME}"
  resurrect_dir="${resurrect_dir//\$HOME/$HOME}"
  printf '%s/last\n' "${resurrect_dir%/}"
}

send_restore_command() {
  local target="$1"
  local command_text="$2"

  tmux display-message -p -t "$target" '#{pane_id}' >/dev/null 2>&1 || return 0
  tmux send-keys -t "$target" -l "$command_text"
  tmux send-keys -t "$target" C-m
}

restore_panes() {
  local state_file
  state_file="$(resurrect_file)"
  [[ -f "$state_file" ]] || return 0

  local line_type session_name window_index pane_index state remainder
  local target encoded environment quoted_environment command_text
  while IFS=$'\t' read -r line_type session_name window_index pane_index state remainder; do
    [[ "$line_type" == "$record_type" ]] || continue
    target="${session_name}:${window_index}.${pane_index}"

    case "$state" in
      inactive)
        command_text='if command -v conda >/dev/null 2>&1; then while [[ ${CONDA_SHLVL:-0} -gt 0 ]]; do conda deactivate || break; done; fi'
        send_restore_command "$target" "$command_text"
        ;;
      active:*)
        encoded="${state#active:}"
        environment="$(printf '%s' "$encoded" | decode_value)" || continue
        [[ -n "$environment" ]] || continue
        printf -v quoted_environment '%q' "$environment"
        command_text="if command -v conda >/dev/null 2>&1; then conda activate ${quoted_environment} || printf '\\n[tmux-resurrect] failed to activate conda environment: %s\\n' ${quoted_environment}; else printf '\\n[tmux-resurrect] conda is unavailable; skipped environment: %s\\n' ${quoted_environment}; fi"
        send_restore_command "$target" "$command_text"
        ;;
    esac
  done < "$state_file"
}

case "${1:-}" in
  track)
    track_pane
    ;;
  save)
    save_panes "${2:-}"
    ;;
  restore)
    restore_panes
    ;;
  *)
    printf 'usage: %s {track|save STATE_FILE|restore}\n' "$0" >&2
    exit 2
    ;;
esac
